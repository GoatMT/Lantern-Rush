rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null && exists(/databases/$(database)/documents/gameLogins/$(request.auth.uid)) && get(/databases/$(database)/documents/gameLogins/$(request.auth.uid)).data.revision==request.auth.token.revision;}
  function own(uid){return signed() && request.auth.uid==uid;}
  function room(code){return get(/databases/$(database)/documents/h2hRooms/$(code)).data;}
  function participant(code){return signed() && request.auth.uid in room(code).members && room(code).expiresAt>request.time.toMillis();}
  match /gameProfiles/{uid} {
   allow read: if true;
   // Identity, credentials, administration and H2H results go through verified callable functions.
   allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats','modes','records','trophies','currentStreak','updatedAtMs','history','historySources']) && request.resource.data.history==resource.data.history && request.resource.data.get('historySources',[])==resource.data.get('historySources',[]);
   match /matches/{id} {
    allow read: if true;
    allow create: if own(uid) && !id.matches('^h2h-.*') && request.resource.data.ownerId==uid && request.resource.data.id==id && request.resource.data.mode in ['quick','rivalry','season','tournament','dream'] && request.resource.data.schemaVersion==2 && request.resource.data.opponent.type=='cpu' && request.resource.data.score is list && request.resource.data.score.size()==2 && request.resource.data.stats is map;
   }
  }
  match /runtime/live{allow read:if true;}
  match /gameUsernames/{name}{allow get:if true;}
  match /gameLogins/{uid}{allow read,write:if false;}
  match /h2hRooms/{code}{
   allow get:if signed();
   allow list:if signed() && request.auth.uid in resource.data.members;
   match /signals/{id}{
    allow read:if participant(code);
    allow create:if participant(code) && room(code).status in ['STARTING','LIVE','CLOSE TO END'] && request.resource.data.keys().hasOnly(['from','epoch','kind','payload','createdAt']) && request.resource.data.from==request.auth.uid && request.resource.data.epoch==room(code).epoch && request.resource.data.kind in ['offer','answer','candidate'] && request.resource.data.payload is string && request.resource.data.payload.size()<16000 && request.resource.data.createdAt==request.time && (request.resource.data.kind!='offer'||room(code).host==request.auth.uid) && (request.resource.data.kind!='answer'||room(code).guest==request.auth.uid);
   }
  }
  match /h2hInvites/{uid}/items/{id}{allow read:if own(uid);}
  match /h2hRecent/{uid}/players/{id}{allow read:if own(uid);}
  match /h2hPresence/{uid}{allow read:if signed();}
 }
}
